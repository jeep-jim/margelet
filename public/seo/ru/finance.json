        "avatar": "https://cdn4.telesco.pe/file/R9LvbWj5_ToC8Eq2JzFrt-ovTywG7LgmIJNWrBduWYPTZ4tj4cT0buK9Xu9NFMuT_ERTnCpobz9sNaFn7MWBviPYus7ZngPbjmO7Sakbnvb__t51pJQv-ZNta2YDNE0hhWD-Sk12JQGzyHoljah9_NJQLl8UmKuQPqKSxNqOejEOoTWL6WTKYMcUkp2sxDUz0tGCk9BexU4JvaLLO8UwrECwPJgpqgX85TwFRuQgi7TG1zrqdJwC8xyFqus_9Gzl-xo8xg4Cga3N3pze30YyETMeAJmzklEqVefmkdaChwN2hPrvJ4oXxEoHZ6BhR8ociUlmgQH_K3UM3i-rLNEGAA.jpg"
