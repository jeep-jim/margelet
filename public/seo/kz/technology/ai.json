        "avatar": "https://cdn4.telesco.pe/file/SRPHH1xl_3YY-X8LHtCp5ie-CFOrAMZIw8ZtJR2hEnBgILiCB1IDs2galelNfUjYU5mYOCtNJunUnnm5dG3BZ3wzNtVv6bkSgx3HFNWjQaSDVk4pRxItNOnkBXVXd02rytPF6Dx7bsfpvp0g-JtP-_zntoIsCtVg_OAo2RMdQ-2bEvFpQG34hL3yk42t5j0puLwxcdTMne0oWa7Ow-SadfKWjIbSOUhb7fXVDE0V7hKMkufDyE_XnDJ5gunCTDdqIqmpPoud98P48nEvdDnw1Njn8CD0XDAeuHCeM6HVlISPWFfZm7F6j4gSsBF-fhMjVzf1vSM184DFJVaghxynzA.jpg"
