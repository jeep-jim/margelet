        "title": "Турагентство POEDEM.KZ",
        "handle": "poedem_kz",
        "verified": false,
        "avatar": "https://cdn4.telesco.pe/file/ESfYyo73KPgUyWfSxSftc4SThnMl6EZT5fvvBDBx9CBKq7LYqay8xIG_KK-2iNWdrOQgb6gKDX_JpSLw8wpJY5LhvLbwTMIhsutoGmWAvtJueGiyjFA7AcH15ec9A58m0ptFKvsCRT0UFg0NY2bMscoJ_BIZmOJWB1Q6ERNbIFwsiqMixOSJPXfiOM-HUHWHCH9C3lm4AIjyfqjUG9iK9EfiGLzEE1k-7PunsbIwXkePQTuAeMdIdzPqtpGC2vt6kIyVSjscAC7yOni8ulgj2ZjM-xfqF4svkY_nZZZYYLVDt47zU0KZl4Uld2rx4f2On41qU-e3-Ypr5_DIGhjlig.jpg"
      },
      "sourceId": "kz:poedem_kz",
