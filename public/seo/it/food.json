        "verified": false,
        "avatar": "https://cdn4.telesco.pe/file/SVK6vY8Bno90zjglXpIiRocIOqf48CdgwmlVGReHQA18smXlh6E1_8oiFVstntM7C-e2Y0Se0lKocdJgGc98zybZ8oUUTTUpf6xrZAEebZgC2kXY-t5BOt8Y0eZbtm7jXcGHsvzXz10u2_nI6kSS4nstFfBYMPy8SYeFoJi1LoY_M8nXslGzzVHqr3rxhTYjUUpXEICoQ6GcRIzTLm59be1Pcm6z9LTgtC_BPsJCV0ThM4Pbou6WIy2DJLyFaknzL8zu3DHdIA5tL1ayejrQad_3XSC3xd8-fJN1pITuOJxk5uSMPjEp3yZnAlDrW_DXxn6PCybF86vM03va8z7tKQ.jpg"
