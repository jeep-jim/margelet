        "avatar": "https://cdn4.telesco.pe/file/Ck6IuaIRo7ZU1VOGQEYal4IdLRSoi2CfK1fNGeyKU7p7xzU7kqWU4AZLRJNQ_GRQ-zEj9KN9O_24H7zCbTkH4fceru5yXCsTqZiiekaK_U4lP3HGggfzuWaGRMPbFfOm8hcoCyopRJk3po0fFoD_A9aCC5JVgFVH8_krZSIU_2T6mCFBzSX5NZ9bw6P8VX6jXs7Zczk1CYBbjCMAu3C3MLonSI3FEzoi4UdOBzh_PIyJTUKKUTfoXyvyky7vS7dMYEmX2g-PDoSKeg_IA5BUxRPuANKRb1cxave9rygsMP_irO4mYScyUXNahgVK_hNPNjDo3MQTtnxJkYR45B_RNg.jpg"
