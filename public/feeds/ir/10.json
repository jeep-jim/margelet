        "handle": "dolar_403",
        "verified": false,
        "avatar": "https://cdn4.telesco.pe/file/mrczMDthNJw0wH3R12H5N4RUQXVjIVnQ9jXUjAK3TARELyFMauWRCKMGB4TsaWG1IqhmsnYLGNE1QCRww-tnPN4sKOMw51oULWSQd9A-cjLAOM7nTDNH9Y83Dm68DZmN-iTjGlNgY2Gi1YhA5rDXYVf2Fib5TuMcwr3VagsftbSOyaSEnm3AcAg2ChVrX_1RgIRetfqGuSW5kwr7Fcb6N8R-sW-ojgvoPlb22P1GNCxdqhA1t6xgQHwvrgfJOxBMTJkeZ1q_HRLqGAt1yyDlS2COM21R7ooajDUlgWGQLhOglfWwIzrXYA-XFBcT3uiWJRg5Np4LY2NyBtEvHq3ggQ.jpg"
