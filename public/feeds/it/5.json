        "title": "L'Era dell'Oro - Antonella e Werner",
        "handle": "antonellawerner",
        "verified": false,
        "avatar": "https://cdn4.telesco.pe/file/OIrF5MsikjbDbV8etM4fKr67I7bgmOeIv0jZMHsxODk4kmNLjhbFyGMG_bwn1OpYT6a2hY0Bup-jWwXMhAJkwRNXSkbLBR0uR55SGGb_12QmkT4oUEOYYtprWKOvhDdseyqAp9dNdMaWI9nC-cPxxTYVgR01Wj42m35FJnSe2fRz0JNQKGiNIW_oV_wucdj4WxxbfSUFw5piKuG1o4ozjg5C5E3rgfTYDueo4dffirtyyPiDtfXiA1MPoz-aJY999L5b_SmCvlNPY_4u1WufRb7A3z4HPQ9UPC_jGbXDWEC3leA7U1Lc-qAixZXzlN6i5Rd2uvUNHhgBVWPygg_niA.jpg"
      },
      "sourceId": "it:antonellawerner",
