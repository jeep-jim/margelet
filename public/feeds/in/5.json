        "verified": false,
        "avatar": "https://cdn5.telesco.pe/file/EnxTD2ckplvPDRSN5DXHzOsDYfTUWZ52ZAZHSwna29WybShSq5IeMZzPC7yLBfuK7dhiqycNkhiSvcnm6-3RVgHhd8F9b7hGulq0R1acvPD7-zVEznaNHAUK0NEhq4fk90QhNL9rvuEPusHdsvyG9Hrhw8M1JAhbqGGNoYohO0_EUjibed5P0w0xsa3t41EN-1SizVFQZjfw3qxhIGykdQWwbPXRS-B0LJfUBs9eDdPSz_1uakIpnqULSBbaPoZx7Et4H9hO0jsrRJELQ_eJrJUdjjuZ7z_c1jiS5AlJPFz64y8zOSPo5iHO3WF1aHTXwnO1uqQuu5zgZPiZ69joiA.jpg"
      },
      "sourceId": "in:banking_ca_ga",
