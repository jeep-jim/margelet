        "verified": false,
        "avatar": "https://cdn4.telesco.pe/file/OC57Vxwbk7LW_fHEWsdTeXXT9xcSV4bOMf6QMFNYBmTkfCyAC7Nd5J3xLY7FraC5DIZHGDO-JH6nY1Z5rITtv_aFhFyGL2fBQ9HbkFDJMMyZwC6hyqeo6DBXP-knjBX3-HT7n7d9Q61GHrnH7cDvzyikI0Hu0ZnKr7aWvHS2-3KIggktXesaaGQD3bD5KNJjXoKEXCZSklEEzX-4aPA3OoZATnGUSobU-Xy-bdtGMSEsYkkDdYVq8lmit5eGy2805iqbfFP9-wezMdKG0VHo_-izRJ57WkarnQ-9Kx02WcEsPF6XECDYsifU4MSti4iIkZW2OFdLQA7BxTImXQQvzg.jpg"
      },
