        "verified": false,
        "avatar": "https://cdn4.telesco.pe/file/LHuTID6dkkwAENLSy0dhbLu4rJOpQvBBu1kSmkM6c5q_gU0nl1D6tdk46zp4ep58aF82HOfYZQ7A_hLWu69nsPGtETrlMko-XywpQXDA5yXYYXoYmvf-_gW6rw3lOicd6zG14EHOeXbQ9yxKARGt6Cnn1NuMygsXFBtseDkMfgz9blWAWw2JVR35Z-e6GKjYCJbUDk8RQiNM6wqwWEQMW52BN4sA1wtLlRC1Jc6IKuphLIc7DLEj5eU54DAR8Q8dLs8_QqwwBR_iUTVk_JtCj3TzGfhHu5Xavh7rN-2iNW99vAu57pkiE9SGnGT9T5E6y-eb3JNSEBx6M2tdCwZCWw.jpg"
