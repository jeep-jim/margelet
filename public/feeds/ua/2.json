        "avatar": "https://cdn4.telesco.pe/file/v7wpePaXrUU7ewGpmYtldrTMS7blQpH1hdOJCf_nMkOJSN46l6YbTdC1lJv1t-yKDEtsYQKgxtAp-sEBuXRPXSe9M2TAyRhuA2Tr-unRyFyLS9Bi4aJnStawveSQ7CTQyB2dsJGE64Gnb9bvIGjF7Wxg5tRd_WMctiV-rKmI717oTy7ujfD773SFGEKRnOf5dmxNmPKTDpuLpHy9TwXWFI0ZQ4ZfnbhZMfVHIzENDhAwbI8sq3VJv7I5AbbeVRQg7wk35nJKImJ1E4hjXgFwTdHRU4R6fQgqL6grHlM855ya4nQLVQdPFWwJNA5fF-m7OVsXC1y2Ce9tVE-zRwGvDA.jpg"
