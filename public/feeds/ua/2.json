        "avatar": "https://cdn4.telesco.pe/file/CcVsC_VhjSeOKDl3TugoYCy6LNOrJRyJb3hdbFbyGtJdXhnU4h1mAAC7H-m2OOVRNzUmPYQduML2h-Gl-mOveL_0hD59fQCiVF6xpxyfNgTC36mlr9GsoynA7VVEuRUyjuEqif2sSw-cAoqfH2DOC5jPB-bC-xrhQGZGvnUIYDUKURckvIaZvqhot2WYiSp4xFebZH0_feiCFoe9qnHgi94IS5DFD2tKf-s-v4NpbfY-u7eZAR2zGhlTolzquhNHU2mHX-EdqMfoOg320XEjzgxrtqfI1YT26y9Dyj7nI0_GlTqxlpJpewWyzyr3npdknOcZOJUnmC326_nAh-ZBZQ.jpg"
