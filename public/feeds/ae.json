        "avatar": "https://cdn4.telesco.pe/file/BSU6_EvCBLdvggRwyProl0NTaoG2Au9KlgNDkIS6Nc9QS7MxvDJDQDVI_dgo5P_hzANJx04bAOdQFKcU9WGt2104e-B92sljN8df0brnq3HdPrJBFTPfR_HjREmPGzQz2LFYiNGyPHqDoOpb55WIRmNYWUrFgCCcIVHxefSFB4q7Bgq8t_VzthAENSeMGjEJJpWlgfE-yKR1Wj8u0TBvy_DBfZmZ_wx0OliPRH0hI6OHyMbUPomcCzE-2EJk_3xaxgxBozuV-1UYda1FrmvHzZmmC5IoQ2lr6cOczxkSS5y9wq58UI8DL5vbdHlMwkoZZG6z-HY_6mSiBA_tlNvVmQ.jpg"
