        "avatar": "https://cdn4.telesco.pe/file/OD78ATWaok1uZ-TTWvEChCauQd196MfJ_xzg6mZTJxiG3yKw_R0hG32w4EBHtBbJenWCp5q8DJT6yjHipmr9Sc1gHCzYvBL8Q9yJIQbA6EsxMiuqI7EiSUs4e8B-MTuONJjqytw1ftqyqoNGJr82qyjglj_l8MmAJ49TSyAReZG0wnnNlBqrJpw45scwLdfRjC-rHZfs4M3rcWSbysNc8jugsdf2dEqQMW3ma2gWN06mYkQsMQlVn9G4qG7geCMKCtPD8J0bxgBseqvFD5wq7ANuUflVXq2anG_LvYogzecRQyxoxK3lGbvJlV0UCLSpIS0VhOzErUpBjMIRdFY9Ng.jpg"
