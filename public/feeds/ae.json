        "avatar": "https://cdn4.telesco.pe/file/FCiqM7BwfEQ71UwtBrH3M8VbB53eAT1FR5y64lPSa7ruAk2ZwEM3GchXNwWptN5CX2vgsd8Z6XhjrDXbfLqQGyn4mWCkzA-hURfNxe6BkhBA2HDqwUmFjtsd4IkfjTGTWQK9_tPdcRzQWsxii1CZlyI-3QvM-6rY6hmIIKroPA3rrjqm3MLTxF4znMWrQvNZXPRc2_jtjScIFZVpgDz0ItPrilTGUqIg9xk7CpGOaYNu1AX-WgtBsTDDAocEq859iY4QY2xZa-hpvNFYlFd__X-RMAbwTizQOxXtqxdOgfPXQW1-7Q6qDBfvFXYx-hBLqbfuc7AHQpdFmCg6Gl6_fw.jpg"
