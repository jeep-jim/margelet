        "handle": "atamekenbusiness",
        "verified": true,
        "avatar": "https://cdn4.telesco.pe/file/OF3CFvM7TZOLMgqfxd9aQUP4GuTX34nrq7mDGY8iWF7AlUI-e2L08x8bbbf7Cytv4tLkj3lRBTsWTpvjblbcI2UHwuobmAsjup9vw0f4XbMxPH72PFKEB96y0Rxdwlpw-CZCRBWECWzKZFtI3Uy7HZkGuKS_scdIRCnW53_PCHqTpmvc0Pht2x4MrJKqgMIZrRoIg6ajXHN8Pr0DeusKdhVYtvmyqclFKMtWMeDehNI4SmLMm3V0vLs2vquuFwFwLc5ZiA3tUKm79g-TBURfVGnyW-d_PBXIWyIFk8lLtrJNCU4NmI77Myri3SK_WqQ6St3QGa9LnvccDjALQKbRCw.jpg"
