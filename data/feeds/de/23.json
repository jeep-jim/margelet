        "avatar": "https://cdn4.telesco.pe/file/ImKCRSvG2BYesyj65THUhO9e2RERasPviwSwb4XJ2cYRL-Vl6JNw-kxkGhE64nGeY2KVVUc-wNTo_AQgVjJLbfiuDt8PXzLB7FZ0amPL2gSfWkO6rOTzzc4t1wT9nsOE620hwRF-lXttAe8DNL5iduE5Fvo8WlJU0DGEE5578qEdgQfoksFEBG5RSuDazABKpgrX3Pociprl3_DWqcjiw0oWaPXeuU2CHPstsrJ42gFxicKPauwXOm8ewifIcY8iAdj0iMcRpHjmZH0RHmuJrmepMjg1-U6GOjz8lqJWckzY0PqtIgT5sgEPejpEmEQvKWpfG-p97Lj2_ILoBUZDNw.jpg"
