        "avatar": "https://cdn4.telesco.pe/file/A6TAXFBiRQFa_yRQ2T1bvohpxf8X9ldY88jEAqGHjoKabDv8kVkrhe0lBH24I49E_SaDEYkR8Vq9W6VNfTazgqZWvpt96jiKZCQdVGZdY8MapQeQSs_gQbjE9EuQ9GjHOVymw8yza1n17zyDrUXlbuR7EdWZtEozC9Ccj66k5UhQGR4bvQTOjAiBaoq-ycGtdUdAZGSmZ-84GFmRLCHHPP1Vh5-bUcAJv52dGch-lyxlOdK87V_UCGZvN3axsbWbOP-zID7lu0gXltBUbHs3x8lce0ZE-RSQj8kIwmnNc4zGL6XEYXqpgqMSV5rWBWN8Bb1WlH2TqNfkI9hT30v6mA.jpg"
