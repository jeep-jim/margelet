        "avatar": "https://cdn4.telesco.pe/file/ModrPKJp70XWqMvxup9KzywhCrA1sV4HswNkzdGm8pirIPoEp8SCERiW9bhnvd_HByYWXFoU5XBrGZrbpy-DMw3INrQndS-IvimyvMed7uix64lBTTxzlplC6KTyLjRvJlRRUOtB_RZQqvzPzVDZMy183ZIZmxmPimxFjUFlq2-kHHe7-__cGnaGXG1P6ZodjDDiVpri8P34ctr6mvXY1UYkX5OrwZaN1vh17KpHLbeti8Z-oDNjsRfXedKwQgMgQaOtPtGrrnfr5gmK5T5ekzdlxjsHd9iMW134g6HCTWUC5m-PWoFtn-7mZVEo3qLR5SNYF0B8NuEosg33OiAD5A.jpg"
      },
      "sourceId": "it:guerrieriperlaliberta",
