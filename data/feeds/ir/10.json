        "avatar": "https://cdn4.telesco.pe/file/BYb2YfPFY9FbwPHdZDv5zGUvNhVQmESTLIgaE07esSwLUMfUfpyT0vGSMRIkimH_EyyzxgBbZRpcCeARh_skz9mhXT4ph47ewtEPhHUTBJpqsOFG_1F95QQd5Yf_ZAxLErM5ZvzW-ZNipBV790AZosno_CBGSjhk8z750uYL29-JtAyf8Q46UdROFA-ZFHbWuQRIF6vZFuLUujLg7VlkTZO4xR5dU9RcPlY7NRNJB4atTwvvBW6Df4D_ap8aGV-WLNq0TjqDk3TQcn3I0QwaJPWCGXboUn-4t6QlasodsTptwAOacfkhreutXSmfvdYgFjkfqXRBJAe000etbTdhMQ.jpg"
