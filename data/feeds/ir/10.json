        "handle": "masaf",
        "verified": false,
        "avatar": "https://cdn4.telesco.pe/file/VTgJMVC4FjqKq9BZQXap8s2HLBuFppuu5CHq8yk_jW8DcnY8uHxfbtv__QbjV-1WzUJTqZ_D8Fc_KoCrubarUTWG5U8F6Xsnwh7W_V3VsY3NsWr3JeNyatuSgYZkz1UKfowzbdUHpTb_xCeuidAf0igv1f_k_B8CXLBGYlfKpJ51CXZbS19MMA5IMglyHy1lC-xiFkY_C0clKrRLvP6k-3MpYNCzuyCLyNHbnoQzvKG7-H8PpZ5ppwCkJUn1OasW1f5cB2JXujR7qVUDOsQ9aC84cfTrghIUlAcmew9vTI1faQ5sq9n5nBDMJpi2WXivcTdqZk2-j2dvOLW85TPYBA.jpg"
      },
      "sourceId": "ir:masaf",
