        "handle": "masaf",
        "verified": false,
        "avatar": "https://cdn4.telesco.pe/file/aY6LsLzBiBfoNAco80-cg2lc5lub41uVwKKmEMu1InYsq9KZf8I41soI79-jeIm7AgHOgt9kWU55-WQIh53qq_Wvuy6eO0N63CXzWWSS3VJq3nGc_rHU1Mv1Cd6GlNO3LBKJGco3FYDBcjfO4CU2ESJS7_qQBujOJ-KFyAXx99qkXqX6m1BzBxuo53jY0eXxG3v176mmyJ1uyudQKCxi1FxvHK1LNV8_8ldGoV-KRF5IlDXZE_jlIQRGkmlOQUocB4SOBP5_ppK__dR1r3HfFilAVQDwRXwwpaDWUhIyO6Hshht2Zkl55-vRq66ag0OdpV95E28zsKMdEfDpf649GQ.jpg"
      },
      "sourceId": "ir:masaf",
