        "avatar": "https://cdn4.telesco.pe/file/rowxA1T5noaw-ZG67zP6scGvSBLgingviTugnXqbb2cbB4aYBmKqRZNHt0Q0uexN2ujOEwOJXTKnMM2-fvBXb2LAgarMgqtj4yFnsSMYH9GlSvX8tkbl9RmZsFTao05HD2E8zYdHWpsGYI6TgyuqQ_DJ5dH7lAiz0vmOhkqJwY7JrKbMWvPyQiIfPe1vcc6FYXrTdRNKF3GdvO0gyWqfT_9ImCyQ9JWZwFE08iZsxYqEP5B20FiezFPwJCmzfT9K10D82DENB17zKaeuyX_d7H7gzxrlSQmya5uKMH6VB2JvRx0Wl_J3_npCSW3nYnpKOfQHLdveIFELNRdmrWLBXw.jpg"
      },
