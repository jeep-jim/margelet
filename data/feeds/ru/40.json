        "handle": "dan_dnr",
        "verified": false,
        "avatar": "https://cdn4.telesco.pe/file/FpGuBKP-v7j8CliASUMdJW-ChSko2emEA_DHggowcxr1RFu7wQB8bJxRYPoStZ_W8YTn5N5a1Y7cXsckJOi-h44lE2VSjCBi1VXLt2zaq4ShWYOFfQ_iNYn2ArCIgGBtaBEG5bEvtzVYqFY1qX6tlIwrYbl5IB8BiTQ6-BMfdS6dYcBmlojXtgrtSu0MNV9rqNAjtnilpf_UxP8f24rvzl3kQz0MwkTC_cs2WkckSBGsM9sdrJS2jn4DJwwG8usYQ6eXEZH5tQarOjc6nYxC9rGs-s5cU0wHxWVye1bZ9dyyH0bhXBN1B811PSu8J4HBlciX-CJC5GotezzkbZRfXA.jpg"
