        "avatar": "https://cdn4.telesco.pe/file/J8J0Hr4j7WrGIT1k4EDIPrOV6Rb60VHvE8jZ0MczIlDwzFicyiRrwBRVWyrB7MG9Wn68a-KPCzWvxbGv1Y8AwzRpxx-8jQxSqI7Xpmb3zU6Vr8LSFlT6yxT-6fJ5RIpD1ZBi4v5tPPAaV_HUqSrUotniDii0xtQnS_5c1C5qTfdlMMj82P4jFX93ZMK065DzmerHrEc4bWteXzjZDOBmnTAU91-wurY2g0jxXa1ayxs7JGow29LHp81BCUR3pObMkq85JwTYmm2d-I6_ltHCRxFCGsQHMZCrPlp9eE64GIUCIYj5mpbNMiZLVgKP9wt2BS-eapdFwERgA7e_23FNrw.jpg"
