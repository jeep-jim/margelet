        "avatar": "https://cdn4.telesco.pe/file/NF6oc3ya9Txq7oAwmcqauMej_x_gc0XPu3UW6MEh35FfVy0V2OgpWFFBKnOUta4CEjQGjWtCSlm14q_AksHVgRqfzb87JoFdeAomAvPpyZWH0FwTpi6BabLpOXkJ_axqU7bF-4tLcHrrVCe9gdJyomkxB4QdEFjRtpf7OWgtq5MeVZTnmm9A7jFpmVHno39TFDh1CitSBgfIZPMUIwFT4T9lNn3ixOFiIoJxYYjkdUIb9KBQaP28DAc5V0Pd9EA12QQQ7ugXrOkkZIxbjEWBb-wcrnfMKw3wO0Hk2wIkgqvqHUUl5-1ltN-L_yKfa58SlDVK4VRn41nndnabp-kOQA.jpg"
