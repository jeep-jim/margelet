        "avatar": "https://cdn5.telesco.pe/file/lcqWfW7t2BjoQax6BSgFOFZj0wkd4SJ-QASuueQf3zkeRf4m6MfTMPha4qjwO9DSwWPO4aPel3C7lvK3VPvaKbGZgqnH4fye_fSBbs6guk0QIB22x1u-SQXZ9IjYrqeRGg-Y1MLy3JmqV8a46WHxMsifvOgG66AB9LlN2_wSCxSxpLZOxkwfKY2dUvZqWu1CGaQroOW2UNTskWekCiHF8HZGkUpkV_UsR-_xp_rgtEmh6euNZOlV5kEqFXdmb8k2zOTb_zeV_hG504jO4fRhYHQkn3BRP5jD-sOCNu1-azlsg7-dBNWjP0DmK53Hj-9DLK4ztU5lgOnTNZdzkmLjPg.jpg"
      },
      "sourceId": "in:e_book_upsc_ssc_railway_ncert_gk",
      "sourceCountryCode": "in",
