        "handle": "delhi_up_police_ssc_gd_constable",
        "verified": false,
        "avatar": "https://cdn5.telesco.pe/file/HUfevKs8qmBd6tI7JhkYz7Y_Mo_w2pJPzdSia7fyv7DjDkSy5EOds1Xyqoq9uWTnKD86lXIPOxkcDybG8-DeySe_tN_4hXIlhJPm8UeLh5YsKxm0ovR_qenUf7rnsLTpRn_bHy_JfE7523PaDcHOQqX3zT7gVZlKKAIeEFHsqAxVdnS1oS0D-Ea61Fq61MCd0V5wrkrV6tt6vHhEkVezllOEnsqDBOFFTy3OCDn1wvIvMClSq7RCYDswkaCpK_dmJ9N6DK6Q20Nin4KIEiDVc65LEf2P3crluO2NGvAe4muK-NxtswHzpEV80a46i4SUC3bcksvBIxicJmwBEP86qQ.jpg"
      },
      "sourceId": "in:delhi_up_police_ssc_gd_constable",
