        "avatar": "https://cdn5.telesco.pe/file/WDuAecbgobwPDyM7XbLAyyLSOGZuHhlU-k14BAoT4riWxleX5Ifsf76R-WS3SfSqCuJB1xn9bh3y7y5WD__j06u-4eAojLBX1UNNTir8B5YIGPJJOFoUvYq6f_htjwuqEbnsK6YOoXKusLyzpbAWIc9jol3ORtCZcrJfDuqXB2XwZsyq2_yXGcsRKEZHPJOM37Trs9JjvIyUhAMhcW4QCr_OgRbwfRFYUfteoRToOvPSU5NuuZmKZ5tJJodWSU8QoyVEIQb1-kUXWT3T6bJM1GlGiXrxaYc_L_EdQyUdiKLqcyctCysxMpZVDE4Bzc3mSxgTRPYfo51N8KkS-d7H4w.jpg"
